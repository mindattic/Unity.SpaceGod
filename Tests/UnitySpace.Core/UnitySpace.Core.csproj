<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-free Unity source (Assets/UnitySpace/Core) as a plain .NET Standard 2.1
       library, matching Unity 6 (C# 9), so the physics is testable in seconds without the editor. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>UnitySpace.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/UnitySpace/Core/**/*.cs" />
  </ItemGroup>
</Project>
